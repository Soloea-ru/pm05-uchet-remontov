# Скопируйте в .env и подставьте свои значения. Файл .env в git не попадает.
SECRET_KEY=change-me

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=svyaz
MYSQL_PASSWORD=svyaz
MYSQL_DATABASE=svyazservice

# Вместо MYSQL_* можно задать одну строку:
# DATABASE_URL=mysql+pymysql://svyaz:svyaz@127.0.0.1:3306/svyazservice?charset=utf8mb4
